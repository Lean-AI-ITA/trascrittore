<html>
<head>
<HTA:APPLICATION
  APPLICATIONNAME="Trascrittore AI"
  BORDER="thin"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SYSMENU="yes"
  SINGLEINSTANCE="yes"
  SCROLL="no"
  INNERBORDER="no"
  ICON="%SystemRoot%\System32\imageres.dll,109"
/>
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>Trascrittore AI</title>
<style>
* { box-sizing:border-box; margin:0; padding:0; }
body {
  background:#0D0D1F;
  color:#F8FAFC;
  font-family:'Segoe UI',Arial,sans-serif;
  overflow:hidden;
  height:100%;
}

/* ── SCHERMATA PRINCIPALE ─────────────────────────────────────────────── */
#pHome {
  display:table;
  width:100%; height:100%;
  text-align:center;
}
#pHome-inner {
  display:table-cell;
  vertical-align:middle;
  padding:40px;
}
.logo-circle {
  width:90px; height:90px;
  background:linear-gradient(135deg,#F97316,#C2410C);
  border-radius:50%;
  margin:0 auto 24px;
  display:table; /* IE compat */
}
.logo-icon {
  display:table-cell;
  vertical-align:middle;
  text-align:center;
  font-size:40px;
  color:#fff;
  line-height:1;
}
.app-name {
  font-size:28px;
  font-weight:700;
  color:#F8FAFC;
  letter-spacing:-.5px;
  margin-bottom:8px;
}
.app-desc {
  font-size:13px;
  color:#6B6B88;
  margin-bottom:40px;
  line-height:1.5;
}

.btn-hero {
  display:inline-block;
  padding:18px 48px;
  background:linear-gradient(135deg,#F97316,#EA580C);
  color:#fff;
  border:none;
  border-radius:50px;
  font-size:16px;
  font-weight:700;
  cursor:pointer;
  font-family:'Segoe UI',Arial,sans-serif;
  letter-spacing:.5px;
  box-shadow:0 4px 24px rgba(249,115,22,.35);
  width:280px;
}
.btn-hero:hover { background:linear-gradient(135deg,#FB923C,#F97316); }
.btn-hero:active { opacity:.9; }

.status-text {
  display:none;
  font-size:12px;
  color:#8B8BA8;
  margin-top:14px;
}
.dot-anim:after {
  content:'...';
  animation:dots 1.2s infinite;
}
@keyframes dots {
  0%   { content:'.'; }
  33%  { content:'..'; }
  66%  { content:'...'; }
}

.dis-link {
  display:inline-block;
  margin-top:32px;
  font-size:11px;
  color:#3A3A5C;
  cursor:pointer;
  text-decoration:none;
  border-bottom:1px solid transparent;
}
.dis-link:hover { color:#EF4444; border-color:#EF4444; }

/* ── PANNELLO PROGRESS ─────────────────────────────────────────────────── */
#pProgress {
  display:none;
  padding:36px;
  height:100%;
}
.phdr { margin-bottom:24px; }
.phdr h2 { font-size:20px; font-weight:700; color:#F97316; }
.phdr p  { font-size:11px; color:#8B8BA8; margin-top:4px; }

.slbl { font-size:13px; font-weight:600; margin-bottom:10px; color:#F8FAFC; }
.track {
  background:#1C1C38; height:10px; border-radius:5px;
  margin-bottom:18px; overflow:hidden; position:relative;
}
.fill {
  background:linear-gradient(90deg,#F97316,#FB923C);
  height:10px; border-radius:5px;
  width:0%; position:absolute; left:0; top:0;
}
.fill-r { background:linear-gradient(90deg,#EF4444,#F87171); }

.logbox {
  background:#080815;
  border:1px solid #1A1A35;
  border-radius:10px;
  height:230px;
  overflow-y:auto;
  padding:14px;
}
.ll {
  font-family:Consolas,'Courier New',monospace;
  font-size:11.5px; line-height:1.9; display:block;
}
.ok   { color:#4ADE80; }
.warn { color:#FCD34D; }
.err  { color:#F87171; }
.info { color:#94A3B8; }

.btn-end {
  display:none; width:100%; margin-top:16px; padding:16px;
  border:none; border-radius:10px;
  font-size:15px; font-weight:700; cursor:pointer;
  font-family:'Segoe UI',Arial,sans-serif;
  background:linear-gradient(135deg,#F97316,#EA580C);
  color:#fff;
  box-shadow:0 4px 20px rgba(249,115,22,.3);
}
.btn-end:hover { background:linear-gradient(135deg,#FB923C,#F97316); }
.btn-r-end { background:linear-gradient(135deg,#EF4444,#DC2626); box-shadow:0 4px 20px rgba(239,68,68,.25); }
.btn-r-end:hover { background:linear-gradient(135deg,#F87171,#EF4444); }
.btn-b-end { background:linear-gradient(135deg,#6366F1,#4F46E5); box-shadow:0 4px 20px rgba(99,102,241,.25); }
.btn-b-end:hover { background:linear-gradient(135deg,#818CF8,#6366F1); }

.enote {
  display:none; margin-top:12px; padding:13px;
  background:#1A0606; border:1px solid #7F1D1D; border-radius:10px;
  font-size:11px; color:#FCA5A5; line-height:1.7;
}
</style>

<script type="text/javascript">
var sh, fs, logFile, baseDir;
var lastLine = 0, done = false, hasErr = false, isDis = false;

function Init() {
  sh      = new ActiveXObject("WScript.Shell");
  fs      = new ActiveXObject("Scripting.FileSystemObject");
  logFile = sh.ExpandEnvironmentStrings("%TEMP%") + "\\trascrittore_log.txt";

  var h = location.href
    .replace("file:///", "")
    .replace(/%20/g, " ")
    .replace(/\//g, "\\");
  baseDir = h.substring(0, h.lastIndexOf("\\") + 1);

  window.resizeTo(520, 440);
  window.moveTo(
    Math.floor((screen.availWidth  - 520) / 2),
    Math.floor((screen.availHeight - 440) / 2)
  );
}

// ── CLICK BOTTONE PRINCIPALE ──────────────────────────────────────────────────
function avvia() {
  var py = baseDir + "trascrittore_env\\Scripts\\python.exe";

  if (fs.FileExists(py)) {
    // Già installato → avvia direttamente
    var app = baseDir + "_sistema\\trascrittore_portable.py";
    sh.Run("\"" + py + "\" \"" + app + "\"", 1, false);
    window.close();
  } else {
    // Prima volta → installa
    byId("heroBtn").disabled = true;
    byId("heroBtn").innerText = "Installazione in corso...";
    byId("statusTxt").style.display = "block";
    isDis = false;
    startProcess("install");
  }
}

function doUninstall() {
  isDis = true;
  window.resizeTo(560, 540);
  window.moveTo(
    Math.floor((screen.availWidth  - 560) / 2),
    Math.floor((screen.availHeight - 540) / 2)
  );
  startProcess("uninstall");
}

// ── AVVIA RUNNER ──────────────────────────────────────────────────────────────
function startProcess(action) {
  lastLine = 0; done = false; hasErr = false;

  byId("pHome").style.display     = "none";
  byId("pProgress").style.display = "block";

  if (isDis) {
    byId("phTitle").innerText = "Disinstallazione";
    byId("phSub").innerText   = "Rimozione in corso...";
    byId("fillBar").className = "fill fill-r";
  } else {
    byId("phTitle").innerText = "Installazione";
    byId("phSub").innerText   = "Configurazione automatica — attendere qualche minuto";
  }

  if (fs.FileExists(logFile)) fs.DeleteFile(logFile);

  // Scrivi file config — evita problemi con parametri su riga di comando
  var cfgFile = sh.ExpandEnvironmentStrings("%TEMP%") + "\\trascrittore_cfg.txt";
  var cfg = fs.OpenTextFile(cfgFile, 2, true);
  cfg.WriteLine("LogFile=" + logFile);
  cfg.WriteLine("Action=" + action);
  cfg.Close();

  // Prima riga scritta subito da JS
  writeLog("STEP|2|Avvio...");
  writeLog("LOG|info|Avvio in corso...");

  var psExe = sh.ExpandEnvironmentStrings("%SystemRoot%")
            + "\\System32\\WindowsPowerShell\\v1.0\\powershell.exe";
  var ps1Src = baseDir + "_sistema\\_setup_runner.ps1";

  // Copia lo script in %TEMP% per evitare il blocco Zone Identifier:
  // quando il pacchetto viene estratto da uno zip, Windows marca TUTTI i file
  // con il Zone Identifier. Anche dopo aver sbloccato AVVIA.hta, il .ps1
  // può rimanere bloccato e PowerShell si rifiuta di eseguirlo.
  // I file creati in %TEMP% dall'HTA non hanno questo blocco.
  var tempPs1 = sh.ExpandEnvironmentStrings("%TEMP%") + "\\trascrittore_runner.ps1";
  try {
    var srcFile = fs.OpenTextFile(ps1Src, 1, false);
    var ps1Content = srcFile.ReadAll();
    srcFile.Close();
    var dstFile = fs.OpenTextFile(tempPs1, 2, true);
    dstFile.Write(ps1Content);
    dstFile.Close();
  } catch(e) {
    addLine("err", "Impossibile leggere _setup_runner.ps1: " + e.message);
    hasErr = true;
    showBtn("RIPROVA", "btn-b-end");
    return;
  }

  var cmd = "\"" + psExe + "\" -WindowStyle Hidden -NonInteractive -NoProfile"
          + " -ExecutionPolicy Bypass"
          + " -File \"" + tempPs1 + "\"";
  sh.Run(cmd, 0, false);

  // Timeout: se dopo 20s PS non scrive, mostra errore
  window.setTimeout(checkTimeout, 20000);
  window.setInterval(pollLog, 700);
}

// ── POLLING ───────────────────────────────────────────────────────────────────
function pollLog() {
  if (done || hasErr) return;
  if (!fs.FileExists(logFile)) return;

  var ts, all;
  try {
    ts  = fs.OpenTextFile(logFile, 1, false);
    all = ts.ReadAll();
    ts.Close();
  } catch(e) { return; }

  var lines = all.split("\r\n");
  for (var i = lastLine; i < lines.length; i++) {
    var line = (lines[i] || "").replace(/^\s+|\s+$/g, "");
    if (!line) continue;

    var p    = line.split("|");
    if (p.length < 3) continue;
    var type = p[0], a = p[1], b = p.slice(2).join("|");

    if (type === "STEP") {
      byId("fillBar").style.width = a + "%";
      byId("stepLbl").innerText   = b;

    } else if (type === "LOG") {
      addLine(a, b);

    } else if (type === "DONE") {
      byId("fillBar").style.width = "100%";
      byId("stepLbl").innerText   = "Completato!";
      done = true;
      if (isDis) {
        showBtn("CHIUDI", "btn-r-end");
      } else {
        // Auto-avvia dopo installazione
        var py  = baseDir + "trascrittore_env\\Scripts\\python.exe";
        var app = baseDir + "_sistema\\trascrittore_portable.py";
        sh.Run("\"" + py + "\" \"" + app + "\"", 1, false);
        showBtn("AVVIA IL TRASCRITTORE", "");
      }

    } else if (type === "ERROR") {
      addLine("err", b);
      byId("stepLbl").innerText     = "Errore — vedi log";
      byId("errNote").style.display = "block";
      hasErr = true;
      showBtn("RIPROVA", "btn-b-end");
    }

    lastLine = i + 1;
  }
}

// ── UI HELPERS ────────────────────────────────────────────────────────────────
function addLine(type, msg) {
  var box  = byId("logBox");
  var span = document.createElement("span");
  span.className = "ll " + type;
  var d   = new Date();
  var pfx = {ok:"OK   ", warn:"!!   ", err:"X    "}[type] || "     ";
  span.innerText = "[" + pad(d.getHours()) + ":" + pad(d.getMinutes())
                 + ":" + pad(d.getSeconds()) + "]  " + pfx + msg;
  box.appendChild(span);
  box.scrollTop = box.scrollHeight;
}

function showBtn(label, cls) {
  var b = byId("endBtn");
  b.style.display = "block";
  b.innerText     = label;
  b.className     = "btn-end " + cls;
}

function endBtnClick() {
  if (hasErr) {
    location.reload();
  } else {
    if (!isDis) {
      var py  = baseDir + "trascrittore_env\\Scripts\\python.exe";
      var app = baseDir + "_sistema\\trascrittore_portable.py";
      sh.Run("\"" + py + "\" \"" + app + "\"", 1, false);
    }
    window.close();
  }
}

function byId(id) { return document.getElementById(id); }
function pad(n)   { return n < 10 ? "0" + n : "" + n; }

function writeLog(line) {
  try {
    var ts = fs.OpenTextFile(logFile, 8, true);
    ts.WriteLine(line);
    ts.Close();
  } catch(e) {}
}

function checkTimeout() {
  if (done || hasErr || lastLine > 2) return; // PS ha già scritto qualcosa
  addLine("err", "PowerShell non risponde. Prova a cliccare Riprova.");
  addLine("info", "Controlla che anche _sistema\\_setup_runner.ps1 sia sbloccato (Proprieta > Sblocca)");
  hasErr = true;
  showBtn("RIPROVA", "btn-b-end");
}
</script>
</head>

<body onload="Init()">

<!-- HOME: un solo bottone -->
<div id="pHome">
  <div id="pHome-inner">
    <div class="logo-circle">
      <div class="logo-icon">&#9679;</div>
    </div>
    <div class="app-name">Trascrittore AI</div>
    <div class="app-desc">
      Trascrivi video e audio in testo<br>
      con intelligenza artificiale — offline
    </div>

    <button class="btn-hero" id="heroBtn" onclick="avvia()">
      &#9654;&nbsp; Avvia Trascrittore
    </button>

    <div class="status-text dot-anim" id="statusTxt">Installazione in corso</div>

    <br>
    <span class="dis-link" onclick="doUninstall()">disinstalla</span>
  </div>
</div>

<!-- PROGRESS: solo durante install/uninstall -->
<div id="pProgress">
  <div class="phdr">
    <h2 id="phTitle">Installazione</h2>
    <p id="phSub">Configurazione automatica — attendere qualche minuto</p>
  </div>

  <div class="slbl" id="stepLbl">Avvio...</div>
  <div class="track"><div class="fill" id="fillBar"></div></div>
  <div class="logbox" id="logBox"></div>
  <div class="enote" id="errNote">
    <strong>Come risolvere:</strong><br>
    &bull; Controlla la connessione internet e clicca Riprova<br>
    &bull; Se persiste, installa Python manualmente da <em>python.org</em>
  </div>
  <button class="btn-end" id="endBtn" onclick="endBtnClick()">AVVIA</button>
</div>

</body>
</html>
