<html>
<head>
<HTA:APPLICATION
  APPLICATIONNAME="Trascrittore AI"
  BORDER="thin"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SYSMENU="yes"
  SINGLEINSTANCE="yes"
  SCROLL="no"
  INNERBORDER="no"
/>
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>Trascrittore AI</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  background: #0F0F23;
  color: #F8FAFC;
  font-family: 'Segoe UI', Arial, sans-serif;
  padding: 36px;
  overflow: hidden;
}
h1   { font-size: 26px; color: #F97316; font-weight: 700; letter-spacing: -.5px; }
.sub { font-size: 11px; color: #8B8BA8; margin-top: 5px; }
.header { margin-bottom: 30px; border-bottom: 1px solid #1E1E40; padding-bottom: 20px; }

.card {
  background: #141430; border-radius: 14px;
  border: 1.5px solid #2A2A50; cursor: pointer;
  margin-bottom: 14px; display: table; width: 100%;
}
.card:hover { border-color: #F97316; background: #1A1A3A; }
.c-icon  { display:table-cell; vertical-align:middle; width:64px;
            text-align:center; font-size:30px; color:#F97316; padding:20px 0; }
.c-body  { display:table-cell; vertical-align:middle; padding:20px 16px 20px 0; }
.c-title { font-size:15px; font-weight:700; color:#F8FAFC; }
.c-desc  { font-size:11px; color:#6B6B88; margin-top:5px; }
.c-arrow { display:table-cell; vertical-align:middle; width:32px; color:#3A3A5C; font-size:16px; }
.card:hover .c-arrow { color:#F97316; }

.card-red:hover { border-color:#EF4444; background:#1A0E0E; }
.card-red:hover .c-arrow { color:#EF4444; }
.c-icon-red { color:#EF4444 !important; font-size:24px !important; }

.footer-note { font-size:10px; color:#2E2E50; text-align:center; margin-top:22px; }

#panelProgress { display:none; }
.step-lbl { font-size:13px; font-weight:600; color:#F8FAFC; margin-bottom:12px; }
.track { background:#1C1C38; height:10px; border-radius:5px; margin-bottom:20px; overflow:hidden; position:relative; }
.fill  { background:#F97316; height:10px; border-radius:5px; width:0%; position:absolute; left:0; top:0; }
.fill-red { background:#EF4444; }

.log-wrap {
  background:#0D0D20; border:1px solid #1E1E40; border-radius:10px;
  height:220px; overflow-y:auto; padding:14px;
}
.log-line { font-family:Consolas,'Courier New',monospace; font-size:11px; line-height:1.7; display:block; }
.ok   { color:#22C55E; }
.warn { color:#F59E0B; }
.err  { color:#EF4444; }
.info { color:#4B4B70; }

.btn-main {
  display:none; width:100%; margin-top:18px; padding:15px;
  background:linear-gradient(135deg,#F97316,#EA580C);
  color:white; border:none; border-radius:10px;
  font-size:14px; font-weight:700; cursor:pointer;
  font-family:'Segoe UI',Arial,sans-serif;
}
.btn-main:hover { background:linear-gradient(135deg,#FB923C,#F97316); }
.btn-red   { background:linear-gradient(135deg,#EF4444,#DC2626); }
.btn-red:hover   { background:linear-gradient(135deg,#F87171,#EF4444); }
.btn-retry { background:linear-gradient(135deg,#6366F1,#4F46E5); }
.btn-retry:hover { background:linear-gradient(135deg,#818CF8,#6366F1); }

.err-note {
  display:none; margin-top:14px; padding:14px;
  background:#200808; border:1px solid #7F1D1D;
  border-radius:10px; font-size:11px; color:#FCA5A5; line-height:1.6;
}
</style>

<script language="VBScript">
Option Explicit

Dim oShell, oFSO, sLogFile, sScriptDir, sAction
Dim iLastLine, bDone, bError, bDanger

' ── Init ─────────────────────────────────────────────────────────────────────
Sub Window_OnLoad()
  Set oShell = CreateObject("WScript.Shell")
  Set oFSO   = CreateObject("Scripting.FileSystemObject")
  sLogFile   = oShell.ExpandEnvironmentStrings("%TEMP%") & "\trascrittore_log.txt"

  Dim href
  href = Location.Href
  href = Replace(href, "file:///", "")
  href = Replace(Replace(href, "%20"," "), "/", "\")
  sScriptDir = Left(href, InStrRev(href, "\"))

  window.resizeTo 580, 560
  window.moveTo (screen.availWidth - 580) \ 2, (screen.availHeight - 560) \ 2

  ' Attacca eventi tramite GetRef — evita ambiguita VBScript/JS sugli onclick HTML
  Set document.getElementById("cardInstalla").onclick    = GetRef("AvviaInstalla")
  Set document.getElementById("cardDisinstalla").onclick = GetRef("AvviaDisinstalla")
  Set document.getElementById("btnMain").onclick         = GetRef("BtnClick")
End Sub

' ── Azioni scelta ─────────────────────────────────────────────────────────────
Sub AvviaInstalla()
  sAction = "install"
  bDanger = False
  document.getElementById("subTitle").innerText = "Installazione in corso — attendere..."
  AvviaProcess()
End Sub

Sub AvviaDisinstalla()
  sAction = "uninstall"
  bDanger = True
  document.getElementById("fillBar").className = "fill fill-red"
  document.getElementById("subTitle").innerText = "Disinstallazione in corso..."
  AvviaProcess()
End Sub

' ── Avvia processo PS1 nascosto ───────────────────────────────────────────────
Sub AvviaProcess()
  iLastLine = 0
  bDone     = False
  bError    = False

  document.getElementById("panelScelta").style.display   = "none"
  document.getElementById("panelProgress").style.display = "block"

  If oFSO.FileExists(sLogFile) Then oFSO.DeleteFile sLogFile

  Dim ps1, cmd
  ps1 = sScriptDir & "_sistema\_setup_runner.ps1"
  cmd = "powershell -NonInteractive -ExecutionPolicy Bypass -File """ _
      & ps1 & """ -LogFile """ & sLogFile & """ -Action " & sAction
  oShell.Run cmd, 0, False

  window.setInterval "PollLog", 600
End Sub

' ── Leggi log ogni 600ms ──────────────────────────────────────────────────────
Sub PollLog()
  If bDone Or bError Then Exit Sub
  If Not oFSO.FileExists(sLogFile) Then Exit Sub

  Dim oTS, sAll, aLines, i, line, parts
  On Error Resume Next
  Set oTS = oFSO.OpenTextFile(sLogFile, 1, False)
  If Err.Number <> 0 Then Exit Sub
  sAll = oTS.ReadAll()
  oTS.Close
  On Error GoTo 0

  aLines = Split(sAll, vbCrLf)

  For i = iLastLine To UBound(aLines)
    line = Trim(aLines(i))
    If line <> "" Then
      parts = Split(line, "|", 3)
      If UBound(parts) >= 2 Then
        Select Case parts(0)
          Case "STEP"  : SetStep    CInt(parts(1)), parts(2)
          Case "LOG"   : AppendLog  parts(1), parts(2)
          Case "DONE"
            SetStep 100, "Completato!"
            bDone = True
            If bDanger Then
              ShowBtn "CHIUDI", True, False
            Else
              ShowBtn "AVVIA IL TRASCRITTORE", False, False
            End If
          Case "ERROR"
            AppendLog "err", parts(2)
            SetStep 0, "Errore — vedi log"
            bError = True
            document.getElementById("errNote").style.display = "block"
            ShowBtn "RIPROVA", False, True
        End Select
      End If
    End If
    iLastLine = i + 1
  Next
End Sub

' ── UI helper ─────────────────────────────────────────────────────────────────
Sub SetStep(pct, lbl)
  document.getElementById("fillBar").style.width = pct & "%"
  document.getElementById("stepLbl").innerText   = lbl
End Sub

Sub AppendLog(logType, msg)
  Dim wrap, span, h, m, s
  Set wrap = document.getElementById("logWrap")
  Set span = document.createElement("span")
  span.className = "log-line " & logType

  h = Hour(Now()) : m = Minute(Now()) : s = Second(Now())
  If h<10 Then h="0"&h
  If m<10 Then m="0"&m
  If s<10 Then s="0"&s

  Dim pfx
  Select Case logType
    Case "ok"   : pfx = "OK   "
    Case "warn" : pfx = "!!   "
    Case "err"  : pfx = "X    "
    Case Else   : pfx = "     "
  End Select

  span.innerText = "[" & h & ":" & m & ":" & s & "]  " & pfx & msg
  wrap.appendChild span
  wrap.scrollTop = wrap.scrollHeight
End Sub

Sub ShowBtn(txt, isRed, isRetry)
  Dim btn
  Set btn = document.getElementById("btnMain")
  btn.style.display = "block"
  btn.innerText = txt
  If isRed   Then btn.className = "btn-main btn-red"
  If isRetry Then btn.className = "btn-main btn-retry"
End Sub

Sub BtnClick()
  If bError Then
    Location.Reload
  ElseIf bDanger Then
    window.close()
  Else
    Dim py, app
    py  = sScriptDir & "trascrittore_env\Scripts\python.exe"
    app = sScriptDir & "_sistema\trascrittore_portable.py"
    oShell.Run Chr(34) & py & Chr(34) & " " & Chr(34) & app & Chr(34), 1, False
    window.close()
  End If
End Sub
</script>
</head>

<body>

<div class="header">
  <h1>&#9679; Trascrittore AI</h1>
  <div class="sub" id="subTitle">Trascrivi video e audio in testo con intelligenza artificiale &mdash; funziona offline</div>
</div>

<!-- SCELTA -->
<div id="panelScelta">
  <div style="font-size:15px;font-weight:600;color:#A0A0C0;margin-bottom:18px;">Cosa vuoi fare?</div>

  <div class="card" id="cardInstalla">
    <div class="c-icon">&#9654;</div>
    <div class="c-body">
      <div class="c-title">Installa Trascrittore AI</div>
      <div class="c-desc">Scarica e configura Python, motore AI e FFmpeg automaticamente</div>
    </div>
    <div class="c-arrow">&#10095;</div>
  </div>

  <div class="card card-red" id="cardDisinstalla">
    <div class="c-icon c-icon-red">&#10006;</div>
    <div class="c-body">
      <div class="c-title">Disinstalla</div>
      <div class="c-desc">Rimuove ambiente virtuale, modelli AI, FFmpeg e scorciatoie</div>
    </div>
    <div class="c-arrow">&#10095;</div>
  </div>

  <div class="footer-note">Powered by OpenAI Whisper &nbsp;&bull;&nbsp; Funziona completamente offline dopo la prima installazione</div>
</div>

<!-- PROGRESS -->
<div id="panelProgress">
  <div class="step-lbl" id="stepLbl">Avvio...</div>
  <div class="track"><div class="fill" id="fillBar"></div></div>
  <div class="log-wrap" id="logWrap"></div>
  <div class="err-note" id="errNote">
    <strong>Come risolvere:</strong><br>
    &bull; Controlla la connessione internet e riprova<br>
    &bull; Se continua, installa Python manualmente da <em>python.org</em>
  </div>
  <button class="btn-main" id="btnMain">AVVIA IL TRASCRITTORE</button>
</div>

</body>
</html>
