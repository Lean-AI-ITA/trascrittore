<html>
<head>
<HTA:APPLICATION
  APPLICATIONNAME="Trascrittore AI"
  BORDER="thin"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SYSMENU="yes"
  SINGLEINSTANCE="no"
  SCROLL="no"
  INNERBORDER="no"
/>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=11">
<title>Trascrittore AI</title>
<style>
* { box-sizing:border-box; margin:0; padding:0; }
html { height:100%; }
body {
  background:#0D0D1F;
  color:#F8FAFC;
  font-family:'Segoe UI',Arial,sans-serif;
  overflow:hidden;
  height:100%;
}
#pHome {
  display:table;
  width:100%; height:100%;
  text-align:center;
}
#pHome-inner {
  display:table-cell;
  vertical-align:middle;
  padding:40px;
}
.logo-circle {
  width:90px; height:90px;
  background:linear-gradient(135deg,#F97316,#C2410C);
  border-radius:50%;
  margin:0 auto 24px;
  display:table;
}
.logo-icon {
  display:table-cell;
  vertical-align:middle;
  text-align:center;
  font-size:40px;
  color:#fff;
  line-height:1;
}
.app-name {
  font-size:28px; font-weight:700;
  color:#F8FAFC; letter-spacing:-.5px; margin-bottom:8px;
}
.app-desc {
  font-size:13px; color:#6B6B88; margin-bottom:40px; line-height:1.5;
}
.btn-hero {
  display:inline-block; padding:18px 48px;
  background:linear-gradient(135deg,#F97316,#EA580C);
  color:#fff; border:none; border-radius:50px;
  font-size:16px; font-weight:700; cursor:pointer;
  font-family:'Segoe UI',Arial,sans-serif;
  letter-spacing:.5px;
  box-shadow:0 4px 24px rgba(249,115,22,.35);
  width:280px;
}
.btn-hero:hover  { background:linear-gradient(135deg,#FB923C,#F97316); }
.btn-hero:active { opacity:.9; }
.status-text {
  display:none; font-size:12px; color:#8B8BA8; margin-top:14px;
}
.dot-anim:after { content:'...'; animation:dots 1.2s infinite; }
@keyframes dots {
  0%  { content:'.'; }
  33% { content:'..'; }
  66% { content:'...'; }
}
.dis-link {
  display:inline-block; margin-top:32px;
  font-size:11px; color:#3A3A5C; cursor:pointer;
  text-decoration:none; border-bottom:1px solid transparent;
}
.dis-link:hover { color:#EF4444; border-color:#EF4444; }

#pProgress {
  display:none; padding:36px; height:100%;
}
.phdr { margin-bottom:24px; }
.phdr h2 { font-size:20px; font-weight:700; color:#F97316; }
.phdr p  { font-size:11px; color:#8B8BA8; margin-top:4px; }
.slbl { font-size:13px; font-weight:600; margin-bottom:10px; color:#F8FAFC; }
.track {
  background:#1C1C38; height:10px; border-radius:5px;
  margin-bottom:18px; overflow:hidden; position:relative;
}
.fill {
  background:linear-gradient(90deg,#F97316,#FB923C);
  height:10px; border-radius:5px;
  width:0%; position:absolute; left:0; top:0;
  transition:width .4s ease;
}
.fill-r { background:linear-gradient(90deg,#EF4444,#F87171); }
.logbox {
  background:#080815; border:1px solid #1A1A35;
  border-radius:10px; height:230px;
  overflow-y:auto; padding:14px;
}
.ll {
  font-family:Consolas,'Courier New',monospace;
  font-size:11.5px; line-height:1.9; display:block;
}
.ok   { color:#4ADE80; }
.warn { color:#FCD34D; }
.err  { color:#F87171; }
.info { color:#94A3B8; }
.btn-end {
  display:none; width:100%; margin-top:16px; padding:16px;
  border:none; border-radius:10px;
  font-size:15px; font-weight:700; cursor:pointer;
  font-family:'Segoe UI',Arial,sans-serif;
  background:linear-gradient(135deg,#F97316,#EA580C);
  color:#fff; box-shadow:0 4px 20px rgba(249,115,22,.3);
}
.btn-end:hover   { background:linear-gradient(135deg,#FB923C,#F97316); }
.btn-r-end { background:linear-gradient(135deg,#EF4444,#DC2626); box-shadow:0 4px 20px rgba(239,68,68,.25); }
.btn-r-end:hover { background:linear-gradient(135deg,#F87171,#EF4444); }
.btn-b-end { background:linear-gradient(135deg,#6366F1,#4F46E5); box-shadow:0 4px 20px rgba(99,102,241,.25); }
.btn-b-end:hover { background:linear-gradient(135deg,#818CF8,#6366F1); }
.enote {
  display:none; margin-top:12px; padding:13px;
  background:#1A0606; border:1px solid #7F1D1D;
  border-radius:10px; font-size:11px; color:#FCA5A5; line-height:1.7;
}
</style>

<script type="text/javascript">
var sh, fs, logFile, baseDir;
var lastLine = 0, done = false, hasErr = false, isDis = false, needInstall = false;
var pollTimer = null;

function Init() {
  try {
    sh = new ActiveXObject("WScript.Shell");
    fs = new ActiveXObject("Scripting.FileSystemObject");
  } catch(e) {
    // ActiveX bloccato (Zone Identifier da ZIP internet) — mostra istruzioni
    var msg = document.getElementById("pZone").getElementsByTagName("div");
    msg[msg.length - 1].innerText = "Errore: " + e.message;
    return;
  }

  logFile = sh.ExpandEnvironmentStrings("%TEMP%") + "\\trascrittore_log.txt";

  var h = location.href
    .replace("file:///", "")
    .replace(/%20/g, " ")
    .replace(/\//g, "\\");
  var sysDir = h.substring(0, h.lastIndexOf("\\"));
  baseDir = sysDir.substring(0, sysDir.lastIndexOf("\\") + 1);

  // ActiveX OK: nascondi schermata errore, mostra home
  document.getElementById("pZone").style.display = "none";
  document.getElementById("pHome").style.display  = "table";

  window.resizeTo(520, 440);
  window.moveTo(
    Math.floor((screen.availWidth  - 520) / 2),
    Math.floor((screen.availHeight - 440) / 2)
  );
}

// ── BOTTONE PRINCIPALE ────────────────────────────────────────────────────────
function avvia() {
  isDis = false;

  // Mostra subito il pannello progress per il check
  byId("pHome").style.display     = "none";
  byId("pProgress").style.display = "block";
  byId("phTitle").innerText = "Controllo componenti";
  byId("phSub").innerText   = "Verifico cosa \u00e8 installato...";
  byId("fillBar").style.width = "15%";
  byId("stepLbl").innerText   = "Controllo in corso...";

  var py    = baseDir + "trascrittore_env\\Scripts\\python.exe";
  var fwDir = baseDir + "trascrittore_env\\Lib\\site-packages\\faster_whisper";
  var ffmp  = baseDir + "ffmpeg.exe";

  var hasVenv  = fs.FileExists(py);
  var hasPkg   = hasVenv && fs.FolderExists(fwDir);
  var hasFfmp  = fs.FileExists(ffmp);
  // Cerca model.bin in qualsiasi sottocartella di models\ (supporta formato old e nuovo HF hub)
  var hasModel = false;
  if (fs.FolderExists(baseDir + "models")) {
    try {
      var modelSearch = new ActiveXObject("WScript.Shell").Exec("cmd /c dir /s /b \"" + baseDir + "models\\model.bin\" 2>nul");
      hasModel = (modelSearch.StdOut.ReadAll().length > 0);
    } catch(e) {
      hasModel = fs.FileExists(baseDir + "models\\base\\model.bin");
    }
  }

  addLine("info", "Cartella rilevata: " + baseDir);
  addLine(hasVenv  ? "ok" : "warn", "Ambiente Python:    " + (hasVenv  ? "OK" : "da installare"));
  addLine(hasPkg   ? "ok" : "warn", "faster-whisper:     " + (hasPkg   ? "OK" : "da installare"));
  addLine(hasFfmp  ? "ok" : "info", "FFmpeg:             " + (hasFfmp  ? "OK" : "assente (solo audio MP3/WAV)"));
  addLine(hasModel ? "ok" : "warn", "Modello Whisper:    " + (hasModel ? "OK" : "da scaricare"));

  if (hasVenv && hasPkg && hasModel) {
    byId("fillBar").style.width = "100%";
    byId("stepLbl").innerText   = "Tutto pronto \u2014 avvio in corso...";
    var app = baseDir + "_sistema\\trascrittore_portable.py";
    sh.Run("\"" + py + "\" \"" + app + "\"", 1, false);
    window.close();
  } else {
    byId("fillBar").style.width = "20%";
    byId("stepLbl").innerText   = "Avvio installazione tra 2 secondi...";
    window.setTimeout(function() { startProcess("install"); }, 2000);
  }
}

function doUninstall() {
  isDis = true;
  window.resizeTo(560, 540);
  window.moveTo(
    Math.floor((screen.availWidth  - 560) / 2),
    Math.floor((screen.availHeight - 540) / 2)
  );
  startProcess("uninstall");
}

// ── AVVIA INSTALLAZIONE ───────────────────────────────────────────────────────
function startProcess(action) {
  lastLine = 0; done = false; hasErr = false;

  byId("pHome").style.display     = "none";
  byId("pProgress").style.display = "block";

  if (isDis) {
    byId("phTitle").innerText = "Disinstallazione";
    byId("phSub").innerText   = "Rimozione in corso...";
    byId("fillBar").className = "fill fill-r";
  } else {
    byId("phTitle").innerText = "Installazione";
    byId("phSub").innerText   = "Configurazione automatica - attendere qualche minuto";
  }

  if (fs.FileExists(logFile)) fs.DeleteFile(logFile);
  writeLog("STEP|5|Avvio installazione...");
  writeLog("LOG|info|Avvio in corso...");

  // ── Scrivi file in %TEMP% (nessun Zone Identifier, nessuna policy) ──
  var tempBat    = sh.ExpandEnvironmentStrings("%TEMP%") + "\\trascrittore_setup.bat";
  var tempHelper = sh.ExpandEnvironmentStrings("%TEMP%") + "\\trascrittore_helper.py";
  var root = baseDir.replace(/\\$/, "");

  try {
    var f = fs.OpenTextFile(tempBat, 2, true);
    f.Write(buildBat(root, logFile, tempHelper, action));
    f.Close();
    var f2 = fs.OpenTextFile(tempHelper, 2, true);
    f2.Write(buildHelper());
    f2.Close();
  } catch(e) {
    addLine("err", "Errore scrittura script: " + e.message);
    hasErr = true;
    showBtn("RIPROVA", "btn-b-end");
    return;
  }

  // cmd.exe non ha execution policy ne' blocchi Zone Identifier
  sh.Run("cmd.exe /c call \"" + tempBat + "\"", 0, false);

  window.setTimeout(checkTimeout, 30000);
  pollTimer = window.setInterval(pollLog, 700);
}

// ── HELPER PYTHON: progress per pip, download, modello ───────────────────────
function buildHelper() {
  var n = "\n";
  var h = "";
  h += "import sys, os, re, threading, time" + n;
  h += "mode = sys.argv[1]" + n;
  h += "logf = sys.argv[2]" + n;
  h += n;
  h += "def wlog(l):" + n;
  h += "    try:" + n;
  h += "        s = re.sub(r'[^\\x09\\x20-\\x7E]', '', str(l))" + n;
  h += "        open(logf, 'a').write(s + '\\r\\n')" + n;
  h += "    except: pass" + n;
  h += n;
  // ── modalita' pip_run: esegue pip e mostra output riga per riga nell'UI ──────
  h += "if mode == 'pip_run':" + n;
  h += "    import subprocess" + n;
  h += "    pip_exe = sys.argv[3]" + n;
  h += "    args = sys.argv[4:]" + n;
  h += "    proc = subprocess.Popen(" + n;
  h += "        [pip_exe] + args," + n;
  h += "        stdout=subprocess.PIPE, stderr=subprocess.STDOUT," + n;
  h += "        text=True, encoding='utf-8', errors='replace'" + n;
  h += "    )" + n;
  h += "    for line in proc.stdout:" + n;
  h += "        line = re.sub(r'[^\\x20-\\x7E]', '', line).strip()" + n;
  h += "        if not line: continue" + n;
  h += "        if 'Successfully installed' in line:" + n;
  h += "            wlog('LOG|ok|' + line[:120])" + n;
  h += "        elif any(x in line for x in ['ERROR', 'error', 'Could not', 'No matching', 'FAILED', 'Exception']):" + n;
  h += "            wlog('LOG|warn|pip: ' + line[:120])" + n;
  h += "        elif any(x in line for x in ['Collecting', 'Downloading', 'Installing', 'Using cached', 'Requirement']):" + n;
  h += "            wlog('LOG|info|' + line[:120])" + n;
  h += "    proc.wait()" + n;
  h += "    sys.exit(proc.returncode)" + n;
  h += n;
  // ── modalita' download con progress ───────────────────────────────────────
  h += "elif mode == 'dl':" + n;
  h += "    import urllib.request, socket" + n;
  h += "    socket.setdefaulttimeout(60)" + n;
  h += "    url  = sys.argv[3]; dest = sys.argv[4]" + n;
  h += "    s0, s1 = int(sys.argv[5]), int(sys.argv[6])" + n;
  h += "    label  = sys.argv[7] if len(sys.argv) > 7 else 'Download'" + n;
  h += "    last   = [-1]" + n;
  h += "    def rh(count, block, total):" + n;
  h += "        if total <= 0: return" + n;
  h += "        d  = count * block" + n;
  h += "        p  = min(100, d * 100 // total)" + n;
  h += "        mb = d  // 1048576" + n;
  h += "        mt = total // 1048576" + n;
  h += "        sp = s0 + (s1 - s0) * p // 100" + n;
  h += "        if p // 5 != last[0] // 5:" + n;
  h += "            last[0] = p" + n;
  h += "            wlog('STEP|{}|{}: {} MB / {} MB ({}%)'.format(sp, label, mb, mt, p))" + n;
  h += "            wlog('LOG|info|{}: {} MB / {} MB ({}%)'.format(label, mb, mt, p))" + n;
  h += "    try: urllib.request.urlretrieve(url, dest, rh)" + n;
  h += "    except Exception as e:" + n;
  h += "        wlog('ERROR|0|Download fallito: ' + str(e)[:300]); sys.exit(1)" + n;
  h += n;
  // ── modalita' modello whisper ──────────────────────────────────────────────
  h += "elif mode == 'model':" + n;
  h += "    model_dir = sys.argv[3]" + n;
  h += "    s0, s1 = int(sys.argv[4]), int(sys.argv[5])" + n;
  h += "    stop = [False]" + n;
  h += "    def monitor():" + n;
  h += "        while not stop[0]:" + n;
  h += "            try:" + n;
  h += "                total = sum(os.path.getsize(os.path.join(d,f))" + n;
  h += "                            for d,_,files in os.walk(model_dir) for f in files)" + n;
  h += "                mb = total // 1048576" + n;
  h += "                sp = s0 + min(s1 - s0 - 2, mb * (s1 - s0) // 150)" + n;
  h += "                wlog('STEP|{}|Passo 5/5 - Modello: {} MB / ~150 MB'.format(sp, mb))" + n;
  h += "                wlog('LOG|info|Modello AI: {} MB scaricati su ~150 MB totali'.format(mb))" + n;
  h += "            except: pass" + n;
  h += "            time.sleep(3)" + n;
  h += "    threading.Thread(target=monitor, daemon=True).start()" + n;
  h += "    try:" + n;
  h += "        from faster_whisper import WhisperModel" + n;
  h += "        os.makedirs(model_dir, exist_ok=True)" + n;
  h += "        WhisperModel('base', device='cpu', compute_type='int8', download_root=model_dir)" + n;
  h += "    except Exception as e:" + n;
  h += "        wlog('LOG|warn|Errore modello: ' + str(e)[:200])" + n;
  h += "    finally: stop[0] = True" + n;
  h += "    time.sleep(0.3)" + n;
  return h;
}

// ── COSTRUISCE IL CONTENUTO DEL BAT ──────────────────────────────────────────
function buildBat(root, logF, helperPy, action) {
  var n = "\r\n";
  var b = "";

  b += "@echo off" + n;
  b += "setlocal enabledelayedexpansion" + n;
  b += "chcp 65001 >nul 2>&1" + n;
  b += n;
  b += "set \"ROOT=" + root + "\"" + n;
  b += "set \"LOG=" + logF + "\"" + n;
  b += "set \"VENV=%ROOT%\\trascrittore_env\"" + n;
  b += "set \"PY=%VENV%\\Scripts\\python.exe\"" + n;
  b += "set \"PIP=%VENV%\\Scripts\\pip.exe\"" + n;
  b += "set \"HLP=" + helperPy + "\"" + n;
  b += n;
  b += "echo LOG^|info^|Script avviato (ROOT=%ROOT%)>> \"%LOG%\"" + n;
  b += n;

  // ── DISINSTALLA ──────────────────────────────────────────────────────────
  if (action === "uninstall") {
    b += "echo STEP^|15^|Rimozione ambiente virtuale...>> \"%LOG%\"" + n;
    b += "if not exist \"%VENV%\" goto :dis_no_venv" + n;
    b += "rmdir /s /q \"%VENV%\"" + n;
    b += "echo LOG^|ok^|Ambiente virtuale rimosso>> \"%LOG%\"" + n;
    b += "goto :dis_models" + n;
    b += ":dis_no_venv" + n;
    b += "echo LOG^|info^|Ambiente non presente>> \"%LOG%\"" + n;
    b += ":dis_models" + n;
    b += "echo STEP^|50^|Rimozione modelli AI...>> \"%LOG%\"" + n;
    b += "if not exist \"%ROOT%\\models\" goto :dis_ffmp" + n;
    b += "rmdir /s /q \"%ROOT%\\models\"" + n;
    b += "echo LOG^|ok^|Modelli rimossi>> \"%LOG%\"" + n;
    b += ":dis_ffmp" + n;
    b += "echo STEP^|80^|Rimozione FFmpeg...>> \"%LOG%\"" + n;
    b += "if not exist \"%ROOT%\\ffmpeg.exe\" goto :dis_done" + n;
    b += "del /f \"%ROOT%\\ffmpeg.exe\"" + n;
    b += "echo LOG^|ok^|ffmpeg.exe rimosso>> \"%LOG%\"" + n;
    b += ":dis_done" + n;
    b += "echo STEP^|100^|Disinstallazione completata>> \"%LOG%\"" + n;
    b += "echo DONE^|done^|ok>> \"%LOG%\"" + n;
    b += "exit /b 0" + n;
    return b;
  }

  // ── INSTALLA ─────────────────────────────────────────────────────────────

  // STEP 1: Python
  b += "echo STEP^|5^|Passo 1/5 - Controllo Python...>> \"%LOG%\"" + n;
  b += "set \"PYCMD=\"" + n;
  b += "python --version >nul 2>&1" + n;
  b += "if not errorlevel 1 set \"PYCMD=python\"" + n;
  b += "if defined PYCMD goto :py_found" + n;
  b += "py --version >nul 2>&1" + n;
  b += "if not errorlevel 1 set \"PYCMD=py\"" + n;
  b += "if defined PYCMD goto :py_found" + n;
  // Python non trovato — scarica installer
  b += "echo LOG^|warn^|Python non trovato - scarico installer...>> \"%LOG%\"" + n;
  b += "echo STEP^|8^|Passo 1/5 - Download Python 3.11...>> \"%LOG%\"" + n;
  b += "call :dl \"https://www.python.org/ftp/python/3.11.9/python-3.11.9-amd64.exe\" \"%TEMP%\\py_setup.exe\"" + n;
  b += "if not errorlevel 1 goto :py_dl_ok" + n;
  b += "echo ERROR^|0^|Impossibile scaricare Python. Verifica connessione internet.>> \"%LOG%\"" + n;
  b += "exit /b 1" + n;
  b += ":py_dl_ok" + n;
  b += "echo STEP^|15^|Installo Python...>> \"%LOG%\"" + n;
  b += "echo LOG^|info^|Installazione silenziosa 1-2 min...>> \"%LOG%\"" + n;
  b += "\"%TEMP%\\py_setup.exe\" /quiet InstallAllUsers=0 PrependPath=1 Include_pip=1 Include_tcltk=0" + n;
  b += "del /f \"%TEMP%\\py_setup.exe\" >nul 2>&1" + n;
  b += "for /f \"skip=2 tokens=1,2*\" %%a in ('reg query \"HKCU\\Environment\" /v PATH 2^>nul') do set \"UPATH=%%c\"" + n;
  b += "if defined UPATH set \"PATH=!PATH!;!UPATH!\"" + n;
  b += "python --version >nul 2>&1" + n;
  b += "if not errorlevel 1 set \"PYCMD=python\"" + n;
  b += "if defined PYCMD goto :py_installed_ok" + n;
  b += "echo ERROR^|0^|Python installato ma non nel PATH. Riavvia il PC.>> \"%LOG%\"" + n;
  b += "exit /b 1" + n;
  b += ":py_installed_ok" + n;
  b += "echo LOG^|ok^|Python installato correttamente>> \"%LOG%\"" + n;
  b += "goto :py_ok" + n;
  b += ":py_found" + n;
  b += "echo LOG^|ok^|Python trovato>> \"%LOG%\"" + n;
  b += ":py_ok" + n;
  b += n;

  // STEP 2: Venv
  b += "echo STEP^|28^|Passo 2/5 - Ambiente virtuale...>> \"%LOG%\"" + n;
  b += "if exist \"%PY%\" goto :venv_ok" + n;
  b += "!PYCMD! -m venv \"%VENV%\"" + n;
  b += "if not errorlevel 1 goto :venv_created" + n;
  b += "echo ERROR^|0^|Creazione ambiente virtuale fallita>> \"%LOG%\"" + n;
  b += "exit /b 1" + n;
  b += ":venv_created" + n;
  b += "echo LOG^|ok^|Ambiente virtuale creato>> \"%LOG%\"" + n;
  b += ":venv_ok" + n;
  b += "echo LOG^|ok^|Ambiente virtuale pronto>> \"%LOG%\"" + n;
  b += n;

  // STEP 3: faster-whisper da GitHub Releases (wheels.zip)
  b += "echo STEP^|42^|Passo 3/5 - Controllo faster-whisper...>> \"%LOG%\"" + n;
  b += "if exist \"%VENV%\\Lib\\site-packages\\faster_whisper\" goto :fw_ok" + n;
  b += "echo LOG^|info^|Download librerie da GitHub (~81 MB)...>> \"%LOG%\"" + n;
  b += "\"%PY%\" \"%HLP%\" dl \"%LOG%\" \"https://github.com/Lean-AI-ITA/trascrittore/releases/download/2.0/wheels.zip\" \"%TEMP%\\trascrittore_wheels.zip\" 42 58 \"Passo 3/5 - Librerie\"" + n;
  b += "if not errorlevel 1 goto :fw_dl_ok" + n;
  b += "echo ERROR^|0^|Download librerie fallito. Verifica connessione internet.>> \"%LOG%\"" + n;
  b += "exit /b 1" + n;
  b += ":fw_dl_ok" + n;
  b += "echo LOG^|info^|Estrazione librerie...>> \"%LOG%\"" + n;
  b += "if exist \"%TEMP%\\trascrittore_wheels\" rmdir /s /q \"%TEMP%\\trascrittore_wheels\"" + n;
  b += "mkdir \"%TEMP%\\trascrittore_wheels\" >nul 2>&1" + n;
  b += "tar -xf \"%TEMP%\\trascrittore_wheels.zip\" -C \"%TEMP%\\trascrittore_wheels\" >nul 2>&1" + n;
  b += "if errorlevel 1 powershell -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive '%TEMP%\\trascrittore_wheels.zip' '%TEMP%\\trascrittore_wheels' -Force\"" + n;
  b += "echo STEP^|59^|Passo 3/5 - Installazione librerie...>> \"%LOG%\"" + n;
  b += "echo LOG^|info^|Installo pacchetti locali...>> \"%LOG%\"" + n;
  // Trova dinamicamente la cartella con i .whl (struttura zip incognita)
  b += "set \"WHLDIR=%TEMP%\\trascrittore_wheels\"" + n;
  b += "set \"WHLDIR2=\"" + n;
  b += "for /f \"delims=\" %%f in ('dir /s /b \"%TEMP%\\trascrittore_wheels\\*.whl\" 2^>nul') do if not defined WHLDIR2 set \"WHLDIR2=%%~dpf\"" + n;
  b += "if defined WHLDIR2 set \"WHLDIR=%WHLDIR2%\"" + n;
  b += "echo LOG^|info^|Wheels: %WHLDIR%>> \"%LOG%\"" + n;
  // Aggiorna pip per garantire compatibilita'
  b += "echo LOG^|info^|Aggiornamento pip...>> \"%LOG%\"" + n;
  b += "\"%PY%\" -m pip install --upgrade pip --quiet >nul 2>&1" + n;
  // Tentativo 1: solo locale (nessuna connessione internet)
  b += "echo LOG^|info^|Installo faster-whisper da pacchetti locali...>> \"%LOG%\"" + n;
  b += "\"%PY%\" \"%HLP%\" pip_run \"%LOG%\" \"%PIP%\" install --no-index --find-links \"%WHLDIR%\" faster-whisper" + n;
  b += "if not errorlevel 1 goto :fw_pip_ok" + n;
  // Tentativo 2: locale + PyPI per dipendenze mancanti
  b += "echo LOG^|warn^|Tentativo con PyPI per dipendenze mancanti...>> \"%LOG%\"" + n;
  b += "\"%PY%\" \"%HLP%\" pip_run \"%LOG%\" \"%PIP%\" install --find-links \"%WHLDIR%\" faster-whisper --timeout 120" + n;
  b += "if not errorlevel 1 goto :fw_pip_ok" + n;
  b += "echo ERROR^|0^|pip install fallito - vedi errori sopra nel log>> \"%LOG%\"" + n;
  b += "exit /b 1" + n;
  b += ":fw_pip_ok" + n;
  b += "del /f \"%TEMP%\\trascrittore_wheels.zip\" >nul 2>&1" + n;
  b += "rmdir /s /q \"%TEMP%\\trascrittore_wheels\" >nul 2>&1" + n;
  b += "echo LOG^|ok^|faster-whisper installato>> \"%LOG%\"" + n;
  b += ":fw_ok" + n;
  b += "echo STEP^|62^|Passo 3/5 - faster-whisper OK>> \"%LOG%\"" + n;
  b += "echo LOG^|ok^|faster-whisper pronto>> \"%LOG%\"" + n;
  b += n;

  // STEP 4: FFmpeg
  b += "echo STEP^|63^|Passo 4/5 - Controllo FFmpeg...>> \"%LOG%\"" + n;
  b += "if exist \"%ROOT%\\ffmpeg.exe\" goto :ffmp_ok" + n;
  b += "echo LOG^|warn^|Download FFmpeg (~80 MB)...>> \"%LOG%\"" + n;
  b += "\"%PY%\" \"%HLP%\" dl \"%LOG%\" \"https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip\" \"%TEMP%\\ffmpeg_pkg.zip\" 63 78 \"Passo 4/5 - FFmpeg\"" + n;
  b += "if not errorlevel 1 goto :ffmp_dl_ok" + n;
  b += "echo LOG^|warn^|Download FFmpeg fallito - continuo senza>> \"%LOG%\"" + n;
  b += "goto :model" + n;
  b += ":ffmp_dl_ok" + n;
  b += "echo LOG^|info^|Estrazione FFmpeg...>> \"%LOG%\"" + n;
  b += "mkdir \"%TEMP%\\ffmpeg_ext\" >nul 2>&1" + n;
  b += "tar -xf \"%TEMP%\\ffmpeg_pkg.zip\" -C \"%TEMP%\\ffmpeg_ext\" >nul 2>&1" + n;
  b += "if errorlevel 1 powershell -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive '%TEMP%\\ffmpeg_pkg.zip' '%TEMP%\\ffmpeg_ext' -Force\"" + n;
  b += "set \"FFBIN=\"" + n;
  b += "for /f \"delims=\" %%f in ('dir /s /b \"%TEMP%\\ffmpeg_ext\\bin\\ffmpeg.exe\" 2^>nul') do set \"FFBIN=%%f\"" + n;
  b += "if defined FFBIN copy /y \"%FFBIN%\" \"%ROOT%\\ffmpeg.exe\" >nul" + n;
  b += "rmdir /s /q \"%TEMP%\\ffmpeg_ext\" >nul 2>&1" + n;
  b += "del /f \"%TEMP%\\ffmpeg_pkg.zip\" >nul 2>&1" + n;
  b += "if exist \"%ROOT%\\ffmpeg.exe\" goto :ffmp_ok" + n;
  b += "echo LOG^|warn^|FFmpeg non trovato dopo estrazione - continuo senza>> \"%LOG%\"" + n;
  b += "goto :model" + n;
  b += ":ffmp_ok" + n;
  b += "echo STEP^|79^|Passo 4/5 - FFmpeg OK>> \"%LOG%\"" + n;
  b += "echo LOG^|ok^|FFmpeg pronto>> \"%LOG%\"" + n;
  b += n;

  // STEP 5: Modello Whisper
  b += ":model" + n;
  b += "echo STEP^|82^|Passo 5/5 - Download modello Whisper base...>> \"%LOG%\"" + n;
  // Cerca model.bin in qualsiasi sottocartella (supporta old e nuovo formato HF hub)
  b += "dir /s /b \"%ROOT%\\models\\model.bin\" >nul 2>&1" + n;
  b += "if not errorlevel 1 goto :model_ok" + n;
  b += "echo LOG^|info^|Download modello AI (~150 MB, 1-3 min)...>> \"%LOG%\"" + n;
  b += "\"%PY%\" \"%HLP%\" model \"%LOG%\" \"%ROOT%\\models\" 82 99" + n;
  b += "dir /s /b \"%ROOT%\\models\\model.bin\" >nul 2>&1" + n;
  b += "if not errorlevel 1 goto :model_ok" + n;
  b += "echo LOG^|warn^|Modello verra scaricato al primo avvio>> \"%LOG%\"" + n;
  b += "goto :done" + n;
  b += ":model_ok" + n;
  b += "echo STEP^|99^|Passo 5/5 - Modello OK>> \"%LOG%\"" + n;
  b += "echo LOG^|ok^|Modello AI pronto>> \"%LOG%\"" + n;
  b += n;

  // Fine
  b += ":done" + n;
  b += "echo STEP^|100^|Installazione completata!>> \"%LOG%\"" + n;
  b += "echo LOG^|ok^|Tutto pronto!>> \"%LOG%\"" + n;
  b += "echo DONE^|done^|ok>> \"%LOG%\"" + n;
  b += "exit /b 0" + n;
  b += n;

  // ── Subroutine download ───────────────────────────────────────────────────
  b += ":dl" + n;
  b += "curl -L --silent --show-error --connect-timeout 60 \"%~1\" -o \"%~2\" 2>nul" + n;
  b += "if not errorlevel 1 exit /b 0" + n;
  b += "bitsadmin /transfer trascrittore_dl /download /priority normal \"%~1\" \"%~2\" >nul 2>&1" + n;
  b += "if not errorlevel 1 exit /b 0" + n;
  b += "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Invoke-WebRequest -Uri '%~1' -OutFile '%~2' -UseBasicParsing\"" + n;
  b += "exit /b %errorlevel%" + n;

  return b;
}

// ── POLLING LOG ───────────────────────────────────────────────────────────────
function pollLog() {
  if (done || hasErr) return;
  if (!fs.FileExists(logFile)) return;

  var ts, all;
  try {
    ts  = fs.OpenTextFile(logFile, 1, false);
    all = ts.ReadAll();
    ts.Close();
  } catch(e) { return; }

  var lines = all.split("\r\n");
  for (var i = lastLine; i < lines.length; i++) {
    var line = (lines[i] || "").replace(/^\s+|\s+$/g, "");
    if (!line) continue;

    var p    = line.split("|");
    if (p.length < 3) continue;
    var type = p[0], a = p[1], b = p.slice(2).join("|");

    if (type === "STEP") {
      byId("fillBar").style.width = a + "%";
      byId("stepLbl").innerText   = b;

    } else if (type === "LOG") {
      addLine(a, b);

    } else if (type === "DONE") {
      byId("fillBar").style.width = "100%";
      byId("stepLbl").innerText   = "Completato!";
      done = true;
      if (pollTimer) { window.clearInterval(pollTimer); pollTimer = null; }
      if (isDis) {
        showBtn("CHIUDI", "btn-r-end");
      } else {
        var py  = baseDir + "trascrittore_env\\Scripts\\python.exe";
        var app = baseDir + "_sistema\\trascrittore_portable.py";
        sh.Run("\"" + py + "\" \"" + app + "\"", 1, false);
        showBtn("AVVIA IL TRASCRITTORE", "");
      }

    } else if (type === "ERROR") {
      addLine("err", b);
      byId("stepLbl").innerText     = "Errore - vedi log";
      byId("errNote").style.display = "block";
      hasErr = true;
      if (pollTimer) { window.clearInterval(pollTimer); pollTimer = null; }
      showBtn("RIPROVA", "btn-b-end");
    }

    lastLine = i + 1;
  }
}

// ── UI ────────────────────────────────────────────────────────────────────────
function addLine(type, msg) {
  var box  = byId("logBox");
  var span = document.createElement("span");
  span.className = "ll " + type;
  var d   = new Date();
  var pfx = {ok:"OK   ", warn:"!!   ", err:"X    "}[type] || "     ";
  span.innerText = "[" + pad(d.getHours()) + ":" + pad(d.getMinutes())
                 + ":" + pad(d.getSeconds()) + "]  " + pfx + msg;
  box.appendChild(span);
  box.scrollTop = box.scrollHeight;
}

function showBtn(label, cls) {
  var b = byId("endBtn");
  b.style.display = "block";
  b.innerText     = label;
  b.className     = "btn-end " + cls;
}

function endBtnClick() {
  if (needInstall) {
    needInstall = false;
    byId("endBtn").style.display = "none";
    startProcess("install");
  } else if (hasErr) {
    location.reload();
  } else {
    if (!isDis) {
      var py  = baseDir + "trascrittore_env\\Scripts\\python.exe";
      var app = baseDir + "_sistema\\trascrittore_portable.py";
      sh.Run("\"" + py + "\" \"" + app + "\"", 1, false);
    }
    window.close();
  }
}

function checkTimeout() {
  if (done || hasErr || lastLine > 2) return;
  addLine("err", "L'installazione non ha risposto. Possibili cause:");
  addLine("warn", "- Antivirus ha bloccato cmd.exe o il file .bat in Temp");
  addLine("warn", "- Connessione internet assente per il download di Python");
  addLine("info", "Prova: aggiungi la cartella a esclusioni antivirus e riclicca Riprova");
  hasErr = true;
  showBtn("RIPROVA", "btn-b-end");
}

function writeLog(line) {
  try {
    var ts = fs.OpenTextFile(logFile, 8, true);
    ts.WriteLine(line);
    ts.Close();
  } catch(e) {}
}

function byId(id) { return document.getElementById(id); }
function pad(n)   { return n < 10 ? "0" + n : "" + n; }
</script>
</head>

<body onload="Init()" style="background:#0D0D1F;color:#F8FAFC;margin:0;padding:0;overflow:hidden;height:100%;font-family:'Segoe UI',Arial,sans-serif;">

<!-- ERRORE ZONE IDENTIFIER (visibile di default, nascosto da Init() se ok) -->
<div id="pZone" style="display:table;width:100%;height:100%;text-align:center;">
  <div style="display:table-cell;vertical-align:middle;padding:40px;">
    <div style="font-size:42px;margin-bottom:20px;">&#128274;</div>
    <div style="font-size:20px;font-weight:700;color:#F97316;margin-bottom:12px;">Blocco sicurezza Windows</div>
    <div style="font-size:13px;color:#94A3B8;line-height:1.8;margin-bottom:28px;">
      Il file ZIP deve essere <b style="color:#F8FAFC;">sbloccato</b> prima di usarlo.<br>
      <br>
      <b style="color:#F8FAFC;">Come risolvere:</b><br>
      1&nbsp; Chiudi questa finestra<br>
      2&nbsp; Tasto destro sul file ZIP &rarr; <b style="color:#4ADE80;">Propriet&agrave;</b><br>
      3&nbsp; In fondo spunta <b style="color:#4ADE80;">Sblocca</b> &rarr; OK<br>
      4&nbsp; Estrai di nuovo e riavvia
    </div>
    <div style="font-size:11px;color:#3A3A5C;">Errore: ActiveX bloccato dalla zona di sicurezza Internet</div>
  </div>
</div>

<!-- HOME: bottone avvio -->
<div id="pHome" style="display:none;">
  <div id="pHome-inner">
    <div class="logo-circle">
      <div class="logo-icon">&#9679;</div>
    </div>
    <div class="app-name">Trascrittore AI</div>
    <div class="app-desc">
      Trascrivi video e audio in testo<br>
      con intelligenza artificiale &mdash; offline
    </div>

    <button class="btn-hero" id="heroBtn" onclick="avvia()">
      &#9654;&nbsp; Avvia Trascrittore
    </button>

    <div class="status-text dot-anim" id="statusTxt">Installazione in corso</div>

    <a class="dis-link" onclick="doUninstall()">Disinstalla</a>
  </div>
</div>

<!-- PROGRESS -->
<div id="pProgress">
  <div class="phdr">
    <h2 id="phTitle">Installazione</h2>
    <p id="phSub">Configurazione automatica &mdash; attendere qualche minuto</p>
  </div>

  <div class="slbl" id="stepLbl">Avvio...</div>
  <div class="track">
    <div class="fill" id="fillBar"></div>
  </div>

  <div class="logbox" id="logBox"></div>

  <div class="enote" id="errNote">
    Se l'errore persiste:<br>
    &bull; Verifica che il PC sia connesso a internet<br>
    &bull; Disabilita temporaneamente l'antivirus e riprova<br>
    &bull; Controlla che la cartella non sia su una chiavetta USB (copia prima sul Desktop)
  </div>

  <button class="btn-end" id="endBtn" onclick="endBtnClick()">RIPROVA</button>
</div>

</body>
</html>
